module aluctrl (
	input			   f7:i,
	input		[2:0] f3_i,
	input 	[4:0] aluop_i,
	output  reg  [3:0] aluoperacion_o
	
);

	always @(*)
		begin
			case(aluop_i)
				5'011000: 		//instrucciones S
					begin
						case({f7_i, f3_i})
							4'b0_000:			//suma
								aluoperacion_o = 4'b0_0_00;
							4'b1_000:			//Resta
								aluoperacion_o = 4'b0_1_01;
							4'b0_001:			//STL
								aluoperacion_o = 4'b0_1_10;
							4'b0_111:			//AND
								aluoperacion_o = 4'b0_0_01;
							4'b0_110:			//OR
								aluoperacion_o = 4'b0_0_10;
						endcase
					end
				5'b01000: 		//instrucciones S
					begin
						aluoperacion_o = 4'b0_0_00;
					end
				5'b00000: 		//instrucciones L
					begin
						aluoperacion_o = 4'b0_0_00;
					end
				5'b11000: 		//instrucciones S
					begin
						case(f3_i)
							3'b000:					//BEQ
								aluoperacion_o = 4'b0_1_01;
							3'b100:					//BTL
								aluoperacion_o = 4'b0_1_10;
							3'b001:					//BNE
								aluoperacion_o = 4'b0_1_01;
							3'b101:					//BGE
								aluoperacion_o = 4'b0_1_01;
							
					end
				default:
							aluoperacion_o = 4'b1_1_11;
			endcase
		end
	endmodule
	