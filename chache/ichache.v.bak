module icache(
	input	[7:0] addrrd_i,
	output	[31:0] inst_o

);
	reg 	[31:0] memory [2**8-1:0];	
	initial 
	begin
		$readmemh("bubblesort_inst_5CV1.hex", memory);
	end
	assign 	inst_o = memory[addrrd_i];
endmodule


//pc siempre es en multiplos de 4 
// en una memoria el compilador ordena cada byte en una dirección en un espacio por lo que cada palabra ocupa ese espacio
// sin embargo en nuestra memoria es una palabra de 32bits
